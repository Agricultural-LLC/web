---
import BaseLayout from "@components/base/BaseLayout.astro";
import NewsIndexListView from "@components/news/NewsIndexListView.astro";
import NewsIndexDetailView from "@components/news/NewsIndexDetailView.astro";
import NewsIndexStates from "@components/news/NewsIndexStates.astro";

const siteName = "remono合同会社 Webサイト";
const siteOrigin = "https://remono.co.jp";
const baseTitle = "ニュース";
const baseDescription = "農業DXに関する最新情報をお届けします";

import { firebasePublicConfig } from "@lib/firebase/publicConfig";
const firebaseConfig = firebasePublicConfig;
---

<BaseLayout title={`${baseTitle} | ${siteName}`} description={baseDescription}>
  <section class="py-16 min-h-screen" data-news-root>
    <div class="container">
      <nav class="mb-8" aria-label="パンくずリスト">
        <ol class="flex items-center space-x-2 text-sm text-gray-600">
          <li><a href="/" class="hover:text-purple-600 transition-colors">ホーム</a></li>
          <li><span class="mx-2">/</span></li>
          <li class="text-gray-900 font-medium" id="breadcrumb-current">ニュース</li>
        </ol>
      </nav>

      <div class="row justify-center mb-10">
        <div class="md:col-10 lg:col-8 text-center">
          <h1 id="page-title" class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
            ニュース
          </h1>
          <p id="page-description" class="text-lg text-gray-600">
            農業DXに関する最新情報をお届けします
          </p>
        </div>
      </div>

      <div id="news-loading" class="text-center py-12">
        <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-purple-600"></div>
        <p class="mt-4 text-gray-600">ニュースを読み込み中...</p>
      </div>

      <NewsIndexListView />
      <NewsIndexDetailView />
      <NewsIndexStates />
    </div>
  </section>
</BaseLayout>

<script type="module" define:vars={{ firebaseConfig, baseDescription, baseTitle, siteName, siteOrigin }}>
  import { initNewsPage } from '/scripts/news-page.js';

  initNewsPage({ firebaseConfig, baseDescription, baseTitle, siteName, siteOrigin });
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
